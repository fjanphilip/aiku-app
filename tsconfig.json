{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "app/*": ["app/*"],
      "hooks/*": ["hooks/*"],
      "services/*": ["services/*"],
      "components/*": ["components/*"],
      "types/*": ["types/*"]
    }
  },
  "exclude": ["node_modules"]
}